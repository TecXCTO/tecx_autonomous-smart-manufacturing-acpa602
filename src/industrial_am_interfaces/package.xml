<?xml version="1.0"?>
<?xml-model href="http://ros.org" schematypens="http://w3.org"?>
<package format="3">
  <name>industrial_am_interfaces</name>
  <version>6.2.0</version>
  <description>Custom ROS 2 Message and Service interfaces for real-time laser diagnostics.</description>
  <maintainer email="labs@automation.edu">Advanced Automation Lab Director</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
